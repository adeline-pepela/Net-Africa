"2400"/><a:t>Wrap Agent Execution in Spans</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t>using var span = tracer.StartActivity("agent.run");</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t>span?.SetAttribute("user.query", userQuery);</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t>var response = await agent.Process(userQuery);</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t>span?.SetAttribute("tool_calls_count", response.ToolCalls.Count);</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t></a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t>Export Traces</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0" sz="2400"/><a:t>OpenTelemetry.Exporter.Jaeger or HTTP endpoint</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="942485725"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr><p:transition><p:fade/></p:transition></p:sld>