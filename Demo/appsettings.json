{
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "CustomerSupportAgent",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "Jaeger": {
      "Endpoint": "http://localhost:14250",
      "Protocol": "grpc",
      "Enabled": false
    },
    "Console": {
      "Enabled": false
    }
  },
  "Bedrock": {
    "Region": "us-east-1",
    "Model": "claude-3-5-sonnet-20241022",
    "Endpoint": "https://bedrock-runtime.us-east-1.amazonaws.com",
    "EvaluationEnabled": true,
    "EvaluationModel": "claude-3-5-sonnet-20241022"
  },
  "Evaluation": {
    "CorrectnessThreshold": 0.85,
    "ToolAccuracyThreshold": 0.90,
    "HelpfulnessThreshold": 0.80,
    "InstructionFollowingThreshold": 0.85,
    "SamplingRate": 0.10,
    "EvaluationTimeout": 30000
  },
  "Monitoring": {
    "DashboardUrl": "http://localhost:3000",
    "MetricsPort": 8888,
    "AlertingEnabled": true,
    "AlertThresholdCorrectness": 0.02,
    "AlertThresholdToolAccuracy": 0.03
  }
}
