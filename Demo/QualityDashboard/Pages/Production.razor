@page "/production"
@using QualityDashboard.Services
@inject DashboardService DashboardService
@inject MetricsService MetricsService

<PageTitle>Production Monitoring - Quality Monitoring Dashboard</PageTitle>

<div class="container-fluid">
    <h2 class="mb-4">Production Monitoring - Stage 3: Real-World Monitoring</h2>

    <p class="text-muted">
        Continuous monitoring of live traffic with 10% sampling strategy. Detects quality drift and triggers alerts.
    </p>

    @if (prodMetrics == null)
    {
        <div class="alert alert-info">
            <div class="spinner-border spinner-border-sm me-2"></div>
            Loading production metrics...
        </div>
    }
    else
    {
        <!-- Alert Section -->
        @if (prodMetrics.AlertTriggered)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <h4 class="alert-heading">🚨 Quality Drift Alert</h4>
                <p class="mb-0">@prodMetrics.AlertMessage</p>
                <hr />
                <small>
                    <strong>Recommended Actions:</strong>
                    <ul class="mb-0">
                        <li>Check recent deployments</li>
                        <li>Review failed evaluations</li>
                        <li>Investigate environmental changes</li>
                        <li>Consider rollback if recent deployment</li>
                        <li>Update prompt/logic and re-deploy</li>
                    </ul>
                </small>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Key Metrics -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title text-muted">Total Requests</h6>
                        <h3 class="card-text">@prodMetrics.TotalRequests</h3>
                        <small class="text-muted">In monitoring window</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title text-muted">Evaluations Run</h6>
                        <h3 class="card-text">@prodMetrics.EvaluationsRun</h3>
                        <small class="text-muted">@(Math.Round(prodMetrics.SamplingRate * 100))% sampling</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title text-muted">Monthly Cost</h6>
                        <h3 class="card-text">${@prodMetrics.CostEstimate.ToString("F2")}</h3>
                        <small class="text-muted">At this sampling rate</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title text-muted">Status</h6>
                        <h3 class="card-text">
                            @if (prodMetrics.AlertTriggered)
                            {
                                <span class="text-danger">⚠ Alert</span>
                            }
                            else
                            {
                                <span class="text-success">✓ Healthy</span>
                            }
                        </h3>
                        <small class="text-muted">Monitoring active</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Correctness Trend -->
        <div class="row mb-4">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Correctness Trend</h5>
                    </div>
                    <div class="card-body">
                        @if (prodMetrics.CorrectnessHistory.Any())
                        {
                            <div class="chart-container" style="position: relative; height: 300px;">
                                <canvas id="correctnessChart"></canvas>
                            </div>

                            <div class="mt-4">
                                <div class="row text-center">
                                    <div class="col-md-3">
                                        <small class="text-muted">Latest</small>
                                        <div class="h5">@(Math.Round(prodMetrics.CorrectnessHistory.Last() * 100, 1))%</div>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Average</small>
                                        <div class="h5">@(Math.Round(prodMetrics.CorrectnessHistory.Average() * 100, 1))%</div>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Minimum</small>
                                        <div class="h5">@(Math.Round(prodMetrics.CorrectnessHistory.Min() * 100, 1))%</div>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Maximum</small>
                                        <div class="h5">@(Math.Round(prodMetrics.CorrectnessHistory.Max() * 100, 1))%</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No data available yet</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Tool Accuracy Trend -->
        <div class="row mb-4">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Tool Accuracy Trend</h5>
                    </div>
                    <div class="card-body">
                        @if (prodMetrics.ToolAccuracyHistory.Any())
                        {
                            <div class="chart-container" style="position: relative; height: 300px;">
                                <canvas id="toolAccuracyChart"></canvas>
                            </div>

                            <div class="mt-4">
                                <div class="row text-center">
                                    <div class="col-md-3">
                                        <small class="text-muted">Latest</small>
                                        <div class="h5">@(Math.Round(prodMetrics.ToolAccuracyHistory.Last() * 100, 1))%</div>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Average</small>
                                        <div class="h5">@(Math.Round(prodMetrics.ToolAccuracyHistory.Average() * 100, 1))%</div>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Minimum</small>
                                        <div class="h5">@(Math.Round(prodMetrics.ToolAccuracyHistory.Min() * 100, 1))%</div>
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Maximum</small>
                                        <div class="h5">@(Math.Round(prodMetrics.ToolAccuracyHistory.Max() * 100, 1))%</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No data available yet</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sampling Strategy Info -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Sampling Strategy</h5>
                    </div>
                    <div class="card-body">
                        <p>
                            Current sampling rate: <strong>@(Math.Round(prodMetrics.SamplingRate * 100))%</strong>
                        </p>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6>Cost Analysis</h6>
                                <table class="table table-sm">
                                    <tr>
                                        <td>100% Sampling</td>
                                        <td class="text-end"><strong>~$90/month</strong></td>
                                    </tr>
                                    <tr class="table-success">
                                        <td>10% Sampling</td>
                                        <td class="text-end"><strong>~$9/month</strong></td>
                                    </tr>
                                    <tr>
                                        <td>5% Sampling</td>
                                        <td class="text-end"><strong>~$4.50/month</strong></td>
                                    </tr>
                                    <tr>
                                        <td>1% Sampling</td>
                                        <td class="text-end"><strong>~$0.90/month</strong></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-md-6">
                                <h6>Why 10%?</h6>
                                <ul>
                                    <li>Reduces cost by 90%</li>
                                    <li>Statistically sufficient for 2% drift detection</li>
                                    <li>Fair coverage with stratified sampling</li>
                                    <li>Detects meaningful quality regressions</li>
                                    <li>Balance between cost and coverage</li>
                                </ul>
                            </div>
                        </div>

                        <div class="alert alert-info mb-0">
                            <strong>💡 Pro Tip:</strong> Vary sampling by request type. Evaluate 100% of "cancellation" requests (high impact)
                            but only 5% of "how do I..." requests (lower stakes).
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ProductionMetrics? prodMetrics;

    protected override async Task OnInitializedAsync()
    {
        prodMetrics = await DashboardService.GetProductionMetricsAsync();
    }
}
