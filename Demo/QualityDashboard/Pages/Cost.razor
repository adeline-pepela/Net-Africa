@page "/cost"

<PageTitle>Cost Analysis - Quality Monitoring Dashboard</PageTitle>

<div class="container-fluid">
    <h2 class="mb-4">Cost Analysis & ROI</h2>

    <div class="row mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Monthly Monitoring Cost</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr>
                            <td>Production monitoring (10% sampling)</td>
                            <td class="text-end"><strong>~$90</strong></td>
                        </tr>
                        <tr>
                            <td>CI/CD evaluation (100 PRs/month)</td>
                            <td class="text-end"><strong>~$15</strong></td>
                        </tr>
                        <tr>
                            <td>Local dev (developers testing)</td>
                            <td class="text-end"><strong>~$10</strong></td>
                        </tr>
                        <tr class="table-active">
                            <td><strong>Total Monthly Cost</strong></td>
                            <td class="text-end"><strong class="text-primary">~$115</strong></td>
                        </tr>
                        <tr>
                            <td><strong>Annual Cost</strong></td>
                            <td class="text-end"><strong class="text-primary">~$1,380</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Cost of ONE Prevented Incident</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr>
                            <td>Support team time (8h @@ $75/h)</td>
                            <td class="text-end"><strong>$600</strong></td>
                        </tr>
                        <tr>
                            <td>Engineering/on-call (16h @@ $150/h)</td>
                            <td class="text-end"><strong>$2,400</strong></td>
                        </tr>
                        <tr>
                            <td>Lost productivity / context switching</td>
                            <td class="text-end"><strong>$2,000</strong></td>
                        </tr>
                        <tr>
                            <td>Lost customer revenue (refunds, churn)</td>
                            <td class="text-end"><strong>$8,000-12,000</strong></td>
                        </tr>
                        <tr>
                            <td>Brand/reputation damage</td>
                            <td class="text-end"><em>Incalculable</em></td>
                        </tr>
                        <tr class="table-danger">
                            <td><strong>Total Incident Cost</strong></td>
                            <td class="text-end"><strong>~$13,000-17,000</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ROI Scenarios -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Return on Investment (ROI)</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <div class="roi-box">
                                <h6>Prevent 1 Incident/Year</h6>
                                <div class="roi-metric saved">$13,000</div>
                                <div class="roi-metric">÷ $1,380 cost</div>
                                <div class="roi-result">= <strong>9.4x ROI</strong></div>
                            </div>
                        </div>

                        <div class="col-md-4 text-center mb-3">
                            <div class="roi-box">
                                <h6>Prevent 2 Incidents/Year</h6>
                                <div class="roi-metric saved">$26,000</div>
                                <div class="roi-metric">÷ $1,380 cost</div>
                                <div class="roi-result">= <strong>18.8x ROI</strong></div>
                            </div>
                        </div>

                        <div class="col-md-4 text-center mb-3">
                            <div class="roi-box">
                                <h6>Prevent 3 Incidents/Year</h6>
                                <div class="roi-metric saved">$39,000</div>
                                <div class="roi-metric">÷ $1,380 cost</div>
                                <div class="roi-result">= <strong>28.3x ROI</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success mt-3 mb-0">
                        <strong>Key Finding:</strong> Most teams prevent 1-3 incidents per year with quality monitoring.
                        Even preventing just one incident completely justifies the annual cost.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payback Analysis -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Payback Period</h5>
                </div>
                <div class="card-body">
                    <p>How quickly does monitoring pay for itself?</p>

                    <div class="row">
                        <div class="col-md-6">
                            <h6>At Different Incident Frequencies</h6>
                            <table class="table table-sm">
                                <tr class="table-light">
                                    <th>Incidents/Year</th>
                                    <th>Savings/Year</th>
                                    <th>Payback Period</th>
                                </tr>
                                <tr>
                                    <td>1</td>
                                    <td>$13,000</td>
                                    <td><strong>1.3 weeks</strong></td>
                                </tr>
                                <tr class="table-success">
                                    <td>2</td>
                                    <td>$26,000</td>
                                    <td><strong>1.9 days</strong></td>
                                </tr>
                                <tr>
                                    <td>3</td>
                                    <td>$39,000</td>
                                    <td><strong>1.3 days</strong></td>
                                </tr>
                                <tr>
                                    <td>4</td>
                                    <td>$52,000</td>
                                    <td><strong>10 hours</strong></td>
                                </tr>
                            </table>
                        </div>

                        <div class="col-md-6">
                            <h6>Real-World Example</h6>
                            <p>
                                If your team has had <strong>2-3 support incidents in the past 18 months</strong>,
                                monitoring would have paid for itself <strong>1,000+ times over</strong>.
                            </p>
                            <p>
                                Even <strong>one serious incident</strong> (like shipping wrong agent behavior to production)
                                often costs $10K-30K when you factor in customer impact, support time, and brand damage.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cost Optimization Tips -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Cost Optimization Strategies</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>✓ Reduce Sampling Rate</h6>
                            <p>
                                Start with 10% sampling. If no drift detected over 2 weeks, reduce to 5%.
                                You save cost while maintaining statistical coverage.
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6>✓ Variable Sampling by Request Type</h6>
                            <p>
                                Evaluate 100% of high-stakes requests (cancellations, billing)
                                but only 1% of low-stakes requests (FAQ answers).
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6>✓ Time-Based Sampling</h6>
                            <p>
                                Evaluate more during business hours, less at night/weekends.
                                Automatically adjust based on alert frequency.
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6>✓ Batch Evaluations</h6>
                            <p>
                                Collect 10 traces, evaluate as batch. Reduces API calls while maintaining
                                latency requirements.
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6>✓ Use Cheaper Models for Screening</h6>
                            <p>
                                Use Claude 3 Haiku ($0.80/MTok) for initial screening,
                                escalate to Sonnet only if uncertain.
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6>✓ Cache Common Evaluation Prompts</h6>
                            <p>
                                Use Bedrock prompt caching to cache the evaluation instructions.
                                Reduces cost by 90% on repeated evaluations.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Monitoring Cost vs. Traditional Approaches</h5>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <th>Approach</th>
                                <th>Monthly Cost</th>
                                <th>Catches Regressions</th>
                                <th>Detection Latency</th>
                                <th>Coverage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="table-danger">
                                <td><strong>No Monitoring</strong></td>
                                <td>$0</td>
                                <td>❌ Only via customer complaints</td>
                                <td>Hours to days</td>
                                <td>After customers affected</td>
                            </tr>
                            <tr class="table-warning">
                                <td><strong>Traditional Logging</strong></td>
                                <td>~$300</td>
                                <td>❌ Can't evaluate quality</td>
                                <td>Manual investigation</td>
                                <td>No quality metrics</td>
                            </tr>
                            <tr class="table-success">
                                <td><strong>This Approach (10% sampling)</strong></td>
                                <td>~$115</td>
                                <td>✅ Automated detection</td>
                                <td>Minutes</td>
                                <td>Real-time & CI/CD</td>
                            </tr>
                            <tr class="table-info">
                                <td><strong>Full Evaluation (100%)</strong></td>
                                <td>~$900</td>
                                <td>✅ Catches everything</td>
                                <td>Seconds</td>
                                <td>Every single request</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .roi-box {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 20px;
        background-color: #f8f9fa;
    }

    .roi-metric {
        font-size: 0.95em;
        color: #6c757d;
        margin: 8px 0;
    }

    .roi-metric.saved {
        font-size: 1.8em;
        font-weight: 700;
        color: #198754;
    }

    .roi-result {
        margin-top: 15px;
        font-size: 1.3em;
        padding-top: 15px;
        border-top: 1px solid #dee2e6;
    }
</style>
