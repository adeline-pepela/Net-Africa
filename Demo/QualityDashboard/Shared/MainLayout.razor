@inherits LayoutComponentBase

<div class="page">
    <nav class="navbar navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">
                <span class="badge bg-primary me-2">LIVE</span>
                Quality Monitoring Dashboard
            </span>
            <div class="text-white-50">
                <small>OpenTelemetry • Bedrock Evaluations • Real-time Monitoring</small>
            </div>
        </div>
    </nav>

    <div class="sidebar">
        <nav class="navbar navbar-light bg-light flex-column sticky-top">
            <ul class="nav flex-column w-100">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="icon">📊</span> Overview
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="chat">
                        <span class="icon">💬</span> Interactive Chat
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="evaluation">
                        <span class="icon">✓</span> Quality Gates
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="traces">
                        <span class="icon">🔍</span> Traces
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="production">
                        <span class="icon">📈</span> Production
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="cost">
                        <span class="icon">💰</span> Cost Analysis
                    </NavLink>
                </li>
            </ul>
        </nav>
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .sidebar {
        position: fixed;
        left: 0;
        top: 56px;
        width: 200px;
        height: calc(100vh - 56px);
        background-color: #f8f9fa;
        border-right: 1px solid #dee2e6;
        overflow-y: auto;
        z-index: 999;
    }

    main {
        margin-left: 200px;
        margin-top: 56px;
        flex: 1;
        background-color: #f5f5f5;
        min-height: calc(100vh - 56px);
    }

    .content {
        padding: 20px;
    }

    .nav-link {
        color: #495057 !important;
        padding: 10px 15px;
        border-left: 3px solid transparent;
        transition: all 0.3s ease;
    }

    .nav-link:hover {
        background-color: #e9ecef;
        border-left-color: #0d6efd;
    }

    .nav-link.active {
        color: #0d6efd !important;
        background-color: #e7f1ff;
        border-left-color: #0d6efd;
        font-weight: 500;
    }

    .nav-link .icon {
        margin-right: 8px;
        font-size: 1.2em;
    }

    .navbar-brand {
        font-size: 1.3em;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .sidebar {
            width: 100%;
            height: auto;
            position: relative;
            top: 0;
            border-right: none;
            border-bottom: 1px solid #dee2e6;
        }

        main {
            margin-left: 0;
        }

        .nav {
            flex-direction: row;
            overflow-x: auto;
        }

        .nav-link {
            white-space: nowrap;
            padding: 8px 12px;
            border-left: none;
            border-bottom: 3px solid transparent;
        }

        .nav-link:hover {
            border-left: none;
            border-bottom-color: #0d6efd;
        }

        .nav-link.active {
            border-left: none;
            border-bottom-color: #0d6efd;
        }
    }
</style>
