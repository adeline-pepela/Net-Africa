{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  },
  "QualityThresholds": {
    "Correctness": 0.85,
    "ToolAccuracy": 0.90,
    "Helpfulness": 0.80,
    "InstructionFollowing": 0.80
  },
  "Monitoring": {
    "SamplingRate": 0.10,
    "AlertThreshold": 0.02,
    "BaselineCorrectness": 0.915
  },
  "Evaluation": {
    "Model": "anthropic.claude-3-5-sonnet",
    "MaxTokens": 500
  }
}
