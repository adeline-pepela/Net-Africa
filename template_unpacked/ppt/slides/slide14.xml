call");</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t></a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>llmSpan?.SetAttribute("llm.model",</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>"claude-3.5-sonnet-20241022");</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>llmSpan?.SetAttribute("llm.prompts", prompt);</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>llmSpan?.SetAttribute("llm.temperature", 0.3);</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t></a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>var response = await client.Messages</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>.CreateAsync(new MessageCreateParams</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>{</a:t></a:r></a:p><a:p><a:pPr lvl="6"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Model = "claude-3-5-sonnet-20241022",</a:t></a:r></a:p><a:p><a:pPr lvl="6"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Messages = new[] { new MessageParam</a:t></a:r></a:p><a:p><a:pPr lvl="6"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>{</a:t></a:r></a:p><a:p><a:pPr lvl="8"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Role = "user",</a:t></a:r></a:p><a:p><a:pPr lvl="8"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Content = prompt</a:t></a:r></a:p><a:p><a:pPr lvl="6"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>}},</a:t></a:r></a:p><a:p><a:pPr lvl="6"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>MaxTokens = 2000</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>});</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t></a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>llmSpan?.SetAttribute("llm.usage.input_tokens",</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>response.Usage.InputTokens);</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>llmSpan?.SetAttribute("llm.usage.output_tokens",</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>response.Usage.OutputTokens);</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t></a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>return response.Content[0].Text;</a:t></a:r></a:p><a:p><a:pPr lvl="0"/><a:r><a:rPr lang="en-US" dirty="0"/><a:t>}</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="17" name="Text Placeholder 16"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{45A54F1C-A214-4BCD-8BB4-24532AE1CDA3}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="10"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="322916" y="4692846"/><a:ext cx="3702329" cy="369332"/></a:xfrm></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="pt-BR" dirty="0"/><a:t>Ana Carolina Silva</a:t></a:r><a:endParaRPr lang="en-US" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="18" name="Text Placeholder 17"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{9B5D2294-86C4-4210-BBA0-5AC796DDD35B}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="11"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="322916" y="1492893"/><a:ext cx="3492500" cy="258532"/></a:xfrm></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" dirty="0"/><a:t>ABD229-S</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="19" name="Text Placeholder 18"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns